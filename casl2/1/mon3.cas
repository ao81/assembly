MAIN    START

        LD      GR1,ZERO
        LD      GR0,DATA,GR1
        ADDA    GR1,ONE
        ADDA    GR0,DATA,GR1
        ADDA    GR1,ONE
        ADDA    GR0,DATA,GR1
        ADDA    GR1,ONE
        ADDA    GR0,DATA,GR1
        ST      GR0,ANS
        RET

DATA    DC      3,7,11,15
ANS     DS      1
ZERO    DC      0
ONE     DC      1

        END
