        LD      GR0,0,GR1
        ST      GR0,TEMP
        LAD     GR1,-2,GR1
        LD      GR0,0,GR1
        LAD     GR1,2,GR1
        ST      GR0,0,GR1
        LAD     GR1,-3,GR1
        LD      GR0,0,GR1
        LAD     GR1,1,GR1
